<?xml version="1.0" ?>
<Widget
    Id="CalradiaTavernOverlayRoot"
    WidthSizePolicy="StretchToParent"
    HeightSizePolicy="StretchToParent"
    DoNotAcceptEvents="false"
    DoNotPassEventsToChildren="false">
    <Children>
        <Widget
            Id="CalradiaTavernChatPanel"
            WidthSizePolicy="Fixed"
            HeightSizePolicy="Fixed"
            SuggestedWidth="560"
            SuggestedHeight="280"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            MarginLeft="18"
            MarginBottom="84"
            Sprite="BlankWhiteSquare_9"
            Color="#000000FF"
            AlphaFactor="0.78">
            <Children>
                <TextWidget
                    WidthSizePolicy="CoverChildren"
                    HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MarginLeft="10"
                    MarginTop="8"
                    Brush="MapTextBrushGal"
                    Brush.FontSize="17"
                    Text="@TavernPanelTitle" />

                <TextWidget
                    WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="StretchToParent"
                    MarginLeft="10"
                    MarginRight="10"
                    MarginTop="36"
                    MarginBottom="78"
                    Brush="ChatLog.Text"
                    Brush.FontSize="15"
                    Brush.TextHorizontalAlignment="Left"
                    Brush.TextVerticalAlignment="Top"
                    ClipContents="true"
                    Text="@TavernFeedText" />

                <Widget
                    Id="CalradiaTavernInputParent"
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="450"
                    SuggestedHeight="42"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    MarginLeft="10"
                    MarginBottom="10"
                    Sprite="General\CharacterCreation\name_input_area">
                    <Children>
                        <EditableTextWidget
                            Id="CalradiaTavernInput"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            MarginLeft="8"
                            MarginRight="8"
                            MarginTop="6"
                            MarginBottom="6"
                            Brush="Review.NameInput.Text"
                            RealText="@TavernInputText"
                            Command.Click="ExecuteTavernInputFocus"
                            KeyboardInfoText="@TavernPanelTitle" />
                    </Children>
                </Widget>

                <ButtonWidget
                    WidthSizePolicy="Fixed"
                    HeightSizePolicy="Fixed"
                    SuggestedWidth="90"
                    SuggestedHeight="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    MarginLeft="466"
                    MarginBottom="13"
                    Brush="MapBar.Left.Button"
                    Command.Click="ExecuteTavernSendFromInput">
                    <Children>
                        <TextWidget
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            Brush="MapTextBrushGal"
                            Brush.TextHorizontalAlignment="Center"
                            Brush.TextVerticalAlignment="Center"
                            Text="@TavernSendText" />
                    </Children>
                </ButtonWidget>

                <TextWidget
                    WidthSizePolicy="CoverChildren"
                    HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    MarginLeft="468"
                    MarginBottom="52"
                    Brush="MapTextBrushGal"
                    Brush.FontSize="12"
                    Text="@TavernEnterHintText" />

                <TextWidget
                    WidthSizePolicy="StretchToParent"
                    HeightSizePolicy="CoverChildren"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    MarginLeft="10"
                    MarginRight="10"
                    MarginBottom="0"
                    Brush="ChatLog.Text"
                    Brush.TextHorizontalAlignment="Left"
                    Text="@TavernStatusText"
                    AutoHideIfEmpty="true" />
            </Children>
        </Widget>
    </Children>
</Widget>
