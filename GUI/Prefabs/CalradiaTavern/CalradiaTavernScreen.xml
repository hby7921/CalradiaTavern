<?xml version="1.0"?>
<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget WidthSizePolicy="StretchToParent"
                HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9"
                Color="#000000FF"
                AlphaFactor="0.45" />

        <Widget WidthSizePolicy="Fixed"
                HeightSizePolicy="Fixed"
                SuggestedWidth="1120"
                SuggestedHeight="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9"
                Color="#101114FF"
                AlphaFactor="0.96">
          <Children>
            <ListPanel WidthSizePolicy="StretchToParent"
                       HeightSizePolicy="StretchToParent"
                       MarginLeft="16"
                       MarginRight="16"
                       MarginTop="14"
                       MarginBottom="14"
                       StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent"
                                Brush="Clan.Title.Text"
                                Text="@TitleText" />
                    <ButtonWidget WidthSizePolicy="Fixed"
                                  HeightSizePolicy="Fixed"
                                  SuggestedWidth="110"
                                  SuggestedHeight="34"
                                  Brush="Header.Tab.Center"
                                  Command.Click="ExecuteClose">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    Brush="Clan.TabControl.Text"
                                    Text="@CloseButtonText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <Widget WidthSizePolicy="StretchToParent"
                        HeightSizePolicy="Fixed"
                        SuggestedHeight="2"
                        MarginTop="6"
                        MarginBottom="8"
                        Sprite="BlankWhiteSquare_9"
                        Color="#7A5A2BFF" />

                <ListPanel WidthSizePolicy="StretchToParent"
                           HeightSizePolicy="StretchToParent">
                  <Children>
                    <Widget WidthSizePolicy="Fixed"
                            HeightSizePolicy="StretchToParent"
                            SuggestedWidth="280"
                            Sprite="BlankWhiteSquare_9"
                            Color="#1A1C20FF"
                            MarginRight="10">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="StretchToParent"
                                   MarginLeft="8"
                                   MarginRight="8"
                                   MarginTop="8"
                                   MarginBottom="8"
                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="Fixed"
                                        SuggestedHeight="28"
                                        Brush="Clan.Text.Body"
                                        Brush.FontColor="#E7D6B5FF"
                                        Text="@OnlinePlayersTitleText" />

                            <Widget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9"
                                    Color="#0E1013FF">
                              <Children>
                                <ScrollablePanel WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="StretchToParent"
                                                 MarginLeft="6"
                                                 MarginRight="6"
                                                 MarginTop="6"
                                                 MarginBottom="6"
                                                 AutoHideScrollBars="true"
                                                 ClipRect="PlayersClip"
                                                 InnerPanel="PlayersClip/PlayersList">
                                  <Children>
                                    <Widget Id="PlayersClip"
                                            WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="StretchToParent"
                                            ClipToBounds="true">
                                      <Children>
                                        <ListPanel Id="PlayersList"
                                                   WidthSizePolicy="StretchToParent"
                                                   HeightSizePolicy="CoverChildren"
                                                   DataSource="{OnlinePlayers}"
                                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                                          <ItemTemplate>
                                            <TextWidget WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="CoverChildren"
                                                        MarginBottom="3"
                                                        Brush="Clan.Text.Body"
                                                        Brush.FontColor="#DDE4EDFF"
                                                        Text="@NameText" />
                                          </ItemTemplate>
                                        </ListPanel>
                                      </Children>
                                    </Widget>
                                  </Children>
                                </ScrollablePanel>
                              </Children>
                            </Widget>

                            <Widget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed"
                                    SuggestedHeight="2"
                                    MarginTop="8"
                                    MarginBottom="8"
                                    Sprite="BlankWhiteSquare_9"
                                    Color="#3B3F47FF" />

                            <TextWidget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="Fixed"
                                        SuggestedHeight="22"
                                        Brush="Clan.Text.Body"
                                        Text="Name" />
                            <Widget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed"
                                    SuggestedHeight="40"
                                    Sprite="General\CharacterCreation\name_input_area">
                              <Children>
                                <EditableTextWidget WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="StretchToParent"
                                                    MarginLeft="10"
                                                    MarginRight="10"
                                                    MarginTop="8"
                                                    MarginBottom="8"
                                                    Brush="Review.NameInput.Text"
                                                    RealText="@NameInputText" />
                              </Children>
                            </Widget>
                            <ButtonWidget WidthSizePolicy="StretchToParent"
                                          HeightSizePolicy="Fixed"
                                          SuggestedHeight="34"
                                          MarginTop="6"
                                          Brush="Header.Tab.Center"
                                          Command.Click="ExecuteApplyName">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="StretchToParent"
                                            Brush="Clan.TabControl.Text"
                                            Text="@ApplyNameButtonText" />
                              </Children>
                            </ButtonWidget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>

                    <Widget WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare_9"
                            Color="#17191DFF">
                      <Children>
                        <ListPanel WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="StretchToParent"
                                   MarginLeft="10"
                                   MarginRight="10"
                                   MarginTop="8"
                                   MarginBottom="8"
                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="Fixed"
                                        SuggestedHeight="28"
                                        Brush="Clan.Text.Body"
                                        Brush.FontColor="#E7D6B5FF"
                                        Text="@ChatAreaTitleText" />

                            <Widget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="StretchToParent"
                                    Sprite="BlankWhiteSquare_9"
                                    Color="#0C0F13FF">
                              <Children>
                                <ScrollablePanel WidthSizePolicy="StretchToParent"
                                                 HeightSizePolicy="StretchToParent"
                                                 MarginLeft="6"
                                                 MarginRight="6"
                                                 MarginTop="6"
                                                 MarginBottom="6"
                                                 AutoHideScrollBars="true"
                                                 ClipRect="ChatClip"
                                                 InnerPanel="ChatClip/ChatList">
                                  <Children>
                                    <Widget Id="ChatClip"
                                            WidthSizePolicy="StretchToParent"
                                            HeightSizePolicy="StretchToParent"
                                            ClipToBounds="true">
                                      <Children>
                                        <ListPanel Id="ChatList"
                                                   WidthSizePolicy="StretchToParent"
                                                   HeightSizePolicy="CoverChildren"
                                                   DataSource="{ChatLines}"
                                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                                          <ItemTemplate>
                                            <Widget WidthSizePolicy="StretchToParent"
                                                    HeightSizePolicy="CoverChildren"
                                                    MarginBottom="3">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="CoverChildren"
                                                            Brush="Clan.Text.Body"
                                                            Brush.TextHorizontalAlignment="Left"
                                                            Brush.FontColor="#7EDC95FF"
                                                            IsVisible="@IsSelf"
                                                            Text="@LineText" />
                                                <TextWidget WidthSizePolicy="StretchToParent"
                                                            HeightSizePolicy="CoverChildren"
                                                            Brush="Clan.Text.Body"
                                                            Brush.TextHorizontalAlignment="Left"
                                                            Brush.FontColor="#E9DCC4FF"
                                                            IsHidden="@IsSelf"
                                                            Text="@LineText" />
                                              </Children>
                                            </Widget>
                                          </ItemTemplate>
                                        </ListPanel>
                                      </Children>
                                    </Widget>
                                  </Children>
                                </ScrollablePanel>
                              </Children>
                            </Widget>

                            <ListPanel WidthSizePolicy="StretchToParent"
                                       HeightSizePolicy="Fixed"
                                       SuggestedHeight="52"
                                       MarginTop="8">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="StretchToParent"
                                        Sprite="General\CharacterCreation\name_input_area"
                                        MarginRight="8">
                                  <Children>
                                    <EditableTextWidget WidthSizePolicy="StretchToParent"
                                                        HeightSizePolicy="StretchToParent"
                                                        MarginLeft="10"
                                                        MarginRight="10"
                                                        MarginTop="8"
                                                        MarginBottom="8"
                                                        Brush="Review.NameInput.Text"
                                                        RealText="@ChatInputText"
                                                        KeyboardInfoText="@ChatAreaTitleText" />
                                  </Children>
                                </Widget>
                                <ButtonWidget WidthSizePolicy="Fixed"
                                              HeightSizePolicy="StretchToParent"
                                              SuggestedWidth="120"
                                              Brush="Header.Tab.Center"
                                              MarginRight="8"
                                              Command.Click="ExecuteSendChat">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="StretchToParent"
                                                Brush="Clan.TabControl.Text"
                                                Text="@SendChatButtonText" />
                                  </Children>
                                </ButtonWidget>
                                <ButtonWidget WidthSizePolicy="Fixed"
                                              HeightSizePolicy="StretchToParent"
                                              SuggestedWidth="120"
                                              Brush="Header.Tab.Center"
                                              Command.Click="ExecuteRefreshAll">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="StretchToParent"
                                                Brush="Clan.TabControl.Text"
                                                Text="Refresh" />
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </ListPanel>

                            <TextWidget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="Fixed"
                                        SuggestedHeight="28"
                                        MarginTop="4"
                                        Brush="Clan.Text.Body"
                                        Brush.FontColor="#D8C17CFF"
                                        Text="@StatusText"
                                        AutoHideIfEmpty="true" />
                          </Children>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
