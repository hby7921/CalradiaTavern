<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CalradiaTavern</AssemblyName>
    <RootNamespace>CalradiaTavern</RootNamespace>
    <BannerlordGameDir Condition="'$(BannerlordGameDir)' == ''">F:\steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordGameDir>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(BannerlordGameDir)\bin\Win64_Shipping_Client</ReferenceRoot>
    <ModuleInstallDir Condition="'$(ModuleInstallDir)' == ''">$(BannerlordGameDir)\Modules\CalradiaTavern</ModuleInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Bannerlord.UIExtenderEx">
      <HintPath>$(BannerlordGameDir)\Modules\Bannerlord.UIExtenderEx\bin\Win64_Shipping_Client\Bannerlord.UIExtenderEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BannerlordGameDir)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5">
      <HintPath>$(BannerlordGameDir)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(ReferenceRoot)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection">
      <HintPath>$(ReferenceRoot)\TaleWorlds.Core.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(ReferenceRoot)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(ReferenceRoot)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(ReferenceRoot)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.SaveSystem">
      <HintPath>$(ReferenceRoot)\TaleWorlds.SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(ReferenceRoot)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(ReferenceRoot)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI">
      <HintPath>$(ReferenceRoot)\TaleWorlds.Engine.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI">
      <HintPath>$(ReferenceRoot)\TaleWorlds.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data">
      <HintPath>$(ReferenceRoot)\TaleWorlds.GauntletUI.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(ReferenceRoot)\TaleWorlds.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(ReferenceRoot)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection">
      <HintPath>$(ReferenceRoot)\TaleWorlds.MountAndBlade.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ScreenSystem">
      <HintPath>$(ReferenceRoot)\TaleWorlds.ScreenSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="SubModule.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="GUI\Prefabs\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="GUI\PrefabExtensions\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToGameModule" AfterTargets="Build">
    <MakeDir Directories="$(ModuleInstallDir)" />
    <MakeDir Directories="$(ModuleInstallDir)\bin\Win64_Shipping_Client" />
    <MakeDir Directories="$(ModuleInstallDir)\GUI\Prefabs\CalradiaTavern" />
    <MakeDir Directories="$(ModuleInstallDir)\GUI\PrefabExtensions\Map" />
    <MakeDir Directories="$(ModuleInstallDir)\GUI\PrefabExtensions\Native" />
    <Delete Files="$(ModuleInstallDir)\GUI\Prefabs\SPChatLog.xml" />
    <Delete Files="$(ModuleInstallDir)\GUI\PrefabExtensions\Native\SPChatLog_TavernToggle.xml" />
    <Delete Files="$(ModuleInstallDir)\GUI\PrefabExtensions\Native\SPChatLog_TavernButton.xml" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleInstallDir)\bin\Win64_Shipping_Client" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)SubModule.xml" DestinationFolder="$(ModuleInstallDir)" SkipUnchangedFiles="true" />

    <ItemGroup>
      <UiXml Include="$(TargetDir)GUI\Prefabs\**\*.xml" />
      <UiPatchXml Include="$(TargetDir)GUI\PrefabExtensions\**\*.xml" />
    </ItemGroup>
    <Copy
      SourceFiles="@(UiXml)"
      DestinationFiles="@(UiXml->'$(ModuleInstallDir)\GUI\Prefabs\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(UiPatchXml)"
      DestinationFiles="@(UiPatchXml->'$(ModuleInstallDir)\GUI\PrefabExtensions\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
